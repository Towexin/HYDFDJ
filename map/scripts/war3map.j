=nulltrigger PA=nulltrigger QA=nulltrigger RA=nulltrigger SA=nulltrigger TA=nulltrigger UA=nulltrigger VA=nulltrigger WA=nulltrigger XA=nulltrigger YA=nulltrigger ZA=nulltrigger da=nulltrigger ea=nulltrigger fa=nulltrigger ga=nulltrigger ha=nulltrigger ia=nulltrigger ja=nulltrigger ka=nulltrigger ma=nulltrigger na=nulltrigger oa=nulltrigger pa=nulltrigger qa=nulltrigger ra=nulltrigger sa=nulltrigger ta=nulltrigger ua=nulltrigger va=nulltrigger wa=nulltrigger xa=nulltrigger ya=nulltrigger za=nulltrigger Aa=nulltrigger aa=nulltrigger Ba=nulltrigger ba=nulltrigger Ca=nulltrigger ca=nulltrigger Da=nulltrigger Ea=nulltrigger Fa=nulltrigger Ga=nulltrigger Ha=nulltrigger Ia=nulltrigger la=nulltrigger Ja=nulltrigger Ka=nulltrigger La=nulltrigger Ma=nulltrigger Na=nulltrigger Oa=nulltrigger Pa=nulltrigger Qa=nulltrigger Ra=nulltrigger Sa=nulltrigger Ta=nulltrigger Ua=nulltrigger Va=nulltrigger Wa=nulltrigger Xa=nulltrigger Ya=nulltrigger Za=nulltrigger dB=nulltrigger eB=nulltrigger fB=nulltrigger gB=nulltrigger hB=nulltrigger iB=nulltrigger jB=nulltrigger kB=nulltrigger mB=nulltrigger nB=nulltrigger oB=nulltrigger pB=nulltrigger qB=nulltrigger rB=nulltrigger sB=nulltrigger tB=nulltrigger uB=nulltrigger vB=nulltrigger wB=nulltrigger xB=nulltrigger yB=nulltrigger zB=nulltrigger AB=nulltrigger aB=nulltrigger BB=nulltrigger bB=nulltrigger CB=nulltrigger cB=nulltrigger DB=nulltrigger EB=nulltrigger FB=nulltrigger GB=nulltrigger HB=nulltrigger IB=nulltrigger lB=nulltrigger JB=nulltrigger KB=nulltrigger LB=nulltrigger MB=nulltrigger NB=nulltrigger OB=nulltrigger PB=nulltrigger QB=nulltrigger RB=nulltrigger SB=nulltrigger TB=nulltrigger UB=nulltrigger VB=nulltrigger WB=nulltrigger XB=nulltrigger YB=nulltrigger ZB=nulltrigger db=nulltrigger eb=nulltrigger fb=nullunit gb=nullunit hb=nullunit ib=nullunit jb=nullunit kb=nullunit mb=nullunit nb=nullunit ob=nullunit pb=nullunit qb=nullunit rb=nullunit sb=nullunit tb=nullunit ub=nullunit vb=nullunit wb=nullunit xb=nullunit yb=nullunit zb=nullunit Ab=nullunit ab=nullunit Bb=nullunit bb=nullunit Cb=nullunit cb=nullunit Db=nullunit Eb=nullunit Fb=nullunit Gb=nullunit Hb=nullunit Ib=nullunit lb=nullunit Jb=nullunit Kb=nullunit Lb=nullunit Mb=nullunit Nb=nullunit Ob=nullunit Pb=nullunit Qb=nullunit Rb=nullunit Sb=nullunit Tb=nullunit Ub=nullunit Vb=nullunit Wb=nullunit Xb=nullunit Yb=nullunit Zb=nullunit dC=nullunit eC=nullunit fC=nullunit gC=nullunit hC=nullunit iC=nullunit jC=nullunit kC=nullunit mC=nullunit nC=nullunit oC=nullunit pC=nullunit qC=nullunit rC=nullunit sC=nullunit tC=nullunit uC=nullunit vC=nullunit wC=nullunit xC=nullunit yC=nullunit zC=nullunit AC=nullunit aC=nullunit BC=nullunit bC=nullunit CC=nullunit cC=nullunit DC=nullunit EC=nullunit FC=nullunit GC=nullunit HC=nullunit IC=nullunit lC=nullunit JC=nulltimer KC=nullreal MC=.0real NC=.0group OC=nullforce PC=nullboolexpr QC=nullitem RC=nullendglobalsfunction BalancePrimaryAttribute takes unit u returns integer    local integer id=GetUnitTypeId(u)    if id=='E01E' or id=='E022' or id=='E02Q' or id=='H001' or id=='H007' or id=='H00A' or id=='H00F' or id=='H00G' or id=='H00M' or id=='H00T' or id=='H00V' or id=='H017' or id=='H01G' or id=='H01H' or id=='H01K' or id=='H01O' then        return 0    endif    if id=='H01W' or id=='H022' or id=='H02H' or id=='H02T' or id=='H02U' or id=='H1B1' or id=='H1B2' or id=='H1B3' or id=='H1B4' or id=='H1B5' or id=='H1B6' or id=='H1B7' or id=='H1S1' or id=='H1S2' or id=='H1S3' or id=='H1S4' then        return 0    endif    if id=='H1S5' or id=='Hapm' or id=='Harf' or id=='Hart' or id=='Hdgo' or id=='Hhkl' or id=='Hlgr' or id=='Hmbr' or id=='Hmgd' or id=='Hmkg' or id=='Hpb1' or id=='Hpb2' or id=='Huth' or id=='N00B' or id=='N00I' or id=='N00U' then        return 0    endif    if id=='N00V' or id=='Nal2' or id=='Nal3' or id=='Nalc' or id=='Nalm' or id=='Nbst' or id=='Nkjx' or id=='Nklj' or id=='Nmag' or id=='Nman' or id=='Npbm' or id=='Npld' or id=='Nplh' or id=='Nsjs' or id=='O000' or id=='O002' then        return 0    endif    if id=='O003' or id=='O006' or id=='O00J' or id=='O00L' or id=='O00M' or id=='Ocb2' or id=='Ocbh' or id=='Ogld' or id=='Orex' or id=='Otcc' or id=='Otch' or id=='Uanb' or id=='Ubal' or id=='Ucrl' or id=='Udea' or id=='Udre' then        return 0    endif    if id=='Udth' or id=='Uear' or id=='Umal' or id=='Utic' or id=='Uvar' or id=='Uvng' then        return 0    endif    if id=='E004' or id=='E071' or id=='Edem' or id=='Edmm' or id=='Eevi' or id=='Eevm' or id=='Eidm' or id=='Eill' or id=='Eilm' or id=='Emoo' or id=='Etyr' or id=='Ewar' or id=='Ewrd' or id=='H003' or id=='H005' or id=='H006' then        return 1    endif    if id=='H008' or id=='H009' or id=='H00I' or id=='H00S' or id=='H016' or id=='Hvwd' or id=='N007' or id=='Nbbc' or id=='Nbrn' or id=='Nfir' or id=='O007' or id=='O009' or id=='Obla' or id=='Ogrh' or id=='Opgh' or id=='Orkn' then        return 1    endif    if id=='Osam' or id=='Oshd' or id=='U001' or id=='U009' or id=='Usyl' then        return 1    endif    if id=='E00C' or id=='E00U' or id=='E00X' or id=='E023' or id=='E03W' or id=='E04A' or id=='E04D' or id=='E06N' or id=='E07H' or id=='E080' or id=='E086' or id=='E088' or id=='E08A' or id=='E08G' or id=='Ecen' or id=='Efur' then        return 2    endif    if id=='Ekee' or id=='Ekgg' or id=='Emfr' or id=='Emns' or id=='H00X' or id=='Hamg' or id=='Hant' or id=='Hblm' or id=='Hgam' or id=='Hjai' or id=='Hkal' or id=='Hpal' or id=='Hvsh' or id=='N00D' or id=='N017' or id=='Naka' then        return 2    endif    if id=='Nngs' or id=='Nrob' or id=='Ntin' or id=='O00F' or id=='Odrt' or id=='Ofar' or id=='Othr' or id=='U002' or id=='U004' or id=='Uclc' or id=='Uktl' or id=='Ulic' or id=='Uwar' then        return 2    endif    return -1endfunctionfunction BalanceIsTemporary takes unit u returns boolean    local integer id=GetUnitTypeId(u)    return id=='H1S1' or id=='H1S2' or id=='H1S3' or id=='H1S4' or id=='H1S5' or id=='H1B1' or id=='H1B2' or id=='H1B3' or id=='H1B4' or id=='H1B5' or id=='H1B6' or id=='H1B7'endfunctionfunction BalanceIsMainHero takes unit u returns boolean    return IsUnitType(u,UNIT_TYPE_HERO) and not BalanceIsTemporary(u)endfunctionfunction BalanceAlive takes unit u returns boolean    return u!=null and GetUnitTypeId(u)!=0 and not IsUnitType(u,UNIT_TYPE_DEAD) and GetWidgetLife(u)>0.405endfunctionfunction BalanceError takes unit u,string message returns nothing    call DisplayTimedTextToPlayer(GetOwningPlayer(u),0,0,8.0,"Balance error: "+message)endfunctionfunction BalancePrimaryValue takes unit u returns real    local integer attribute=BalancePrimaryAttribute(u)    if attribute==0 then        return I2R(GetHeroStr(u,true))    elseif attribute==1 then        return I2R(GetHeroAgi(u,true))    elseif attribute==2 then        return I2R(GetHeroInt(u,true))    endif    call BalanceError(u,"unknown primary attribute")    return 0.0endfunctionfunction BalanceDamageBonusAbility takes integer bit returns integer    if bit==0 then        return 'A1D0'    elseif bit==1 then        return 'A1D1'    elseif bit==2 then        return 'A1D2'    elseif bit==3 then        return 'A1D3'    elseif bit==4 then        return 'A1D4'    elseif bit==5 then        return 'A1D5'    elseif bit==6 then        return 'A1D6'    endif    return 0endfunctionfunction BalanceArmorBonusAbility takes integer bit returns integer    if bit==0 then        return 'A1R0'    elseif bit==1 then        return 'A1R1'    elseif bit==2 then        return 'A1R2'    elseif bit==3 then        return 'A1R3'    elseif bit==4 then        return 'A1R4'    elseif bit==5 then        return 'A1R5'    elseif bit==6 then        return 'A1R6'    elseif bit==7 then        return 'A1R7'    elseif bit==8 then        return 'A1R8'    elseif bit==9 then        return 'A1R9'    elseif bit==10 then        return 'A1RA'    elseif bit==11 then        return 'A1RB'    endif    return 0endfunctionfunction BalanceLifeBonusAbility takes integer bit returns integer    if bit==0 then        return 'A1L0'    elseif bit==1 then        return 'A1L1'    elseif bit==2 then        return 'A1L2'    elseif bit==3 then        return 'A1L3'    elseif bit==4 then        return 'A1L4'    elseif bit==5 then        return 'A1L5'    elseif bit==6 then        return 'A1L6'    elseif bit==7 then        return 'A1L7'    elseif bit==8 then        return 'A1L8'    elseif bit==9 then        return 'A1L9'    elseif bit==10 then        return 'A1LA'    elseif bit==11 then        return 'A1LB'    elseif bit==12 then        return 'A1LC'    elseif bit==13 then        return 'A1LD'    endif    return 0endfunctionfunction BalanceApplyBits takes unit u,integer amount,integer kind returns nothing    local integer bit=0    local integer abilId=0    loop        exitwhen amount<=0        if ModuloInteger(amount,2)==1 then            if kind==0 then                set abilId=BalanceDamageBonusAbility(bit)            elseif kind==1 then                set abilId=BalanceArmorBonusAbility(bit)            else                set abilId=BalanceLifeBonusAbility(bit)            endif            if abilId!=0 then                call UnitAddAbility(u,abilId)                call UnitMakeAbilityPermanent(u,true,abilId)            endif        endif        set amount=amount/2        set bit=bit+1    endloopendfunctionfunction BalanceInitializeAttributes takes unit u,unit hero,real factor,integer minDamage,integer minArmor,integer minLife returns boolean    local integer attribute=BalancePrimaryAttribute(hero)    local integer strength=R2I(I2R(GetHeroStr(hero,true))*factor)    local integer agility=R2I(I2R(GetHeroAgi(hero,true))*factor)    local integer intelligence=R2I(I2R(GetHeroInt(hero,true))*factor)    local integer swap=0    local real armor=0.0    if attribute<0 or not IsUnitType(u,UNIT_TYPE_HERO) then        call BalanceError(hero,"invalid hero or unit template")        return false    endif    if attribute==1 then        set swap=strength        set strength=agility        set agility=swap    elseif attribute==2 then        set swap=strength        set strength=intelligence        set intelligence=swap    endif    call SuspendHeroXP(u,true)    call SetHeroStr(u,strength,true)    call SetHeroAgi(u,agility,true)    call SetHeroInt(u,intelligence,true)    call BalanceApplyBits(u,IMaxBJ(0,minDamage-strength),0)    set armor=-2.0+0.15*I2R(agility)    if GetUnitAbilityLevel(u,'A0GN')>0 then        set armor=armor+100.0    endif    call BalanceApplyBits(u,IMaxBJ(0,R2I((I2R(minArmor)-armor)*20.0+0.5)),1)    call BalanceApplyBits(u,IMaxBJ(0,minLife-R2I(GetUnitState(u,UNIT_STATE_MAX_LIFE))),2)    call SetUnitState(u,UNIT_STATE_LIFE,GetUnitState(u,UNIT_STATE_MAX_LIFE))    call SetUnitState(u,UNIT_STATE_MANA,GetUnitState(u,UNIT_STATE_MAX_MANA))    return trueendfunctionfunction BalanceFindFearSlot takes unit target returns integer    local integer i=0    loop        exitwhen i>=32        if o[8000+i]==target then            return 8000+i        endif        set i=i+1    endloop    return -1endfunctionfunction BalanceClearFearSlot takes integer slot returns nothing    set C[slot]=false    set o[slot]=null    set w[slot]=null    set x[slot]=0    set y[slot]=0.0endfunctionfunction BalanceMoveFear takes unit target returns nothing    local integer slot=BalanceFindFearSlot(target)    local real xPos=GetUnitX(target)+GetRandomReal(-250.0,250.0)    local real yPos=GetUnitY(target)+GetRandomReal(-250.0,250.0)    if slot>=0 and C[slot] then        set C[slot]=false        call IssuePointOrder(target,"move",xPos,yPos)        set C[slot]=true    endifendfunctionfunction BalanceClearFear takes unit target returns nothing    local integer slot=BalanceFindFearSlot(target)    if slot>=0 then        call BalanceClearFearSlot(slot)        if BalanceAlive(target) then            call IssueImmediateOrder(target,"stop")        endif    endifendfunctionfunction BalanceStartFear takes unit caster,unit target returns nothing    local integer oldSlot=BalanceFindFearSlot(target)    local integer slot=-1    local integer i=0    if not BalanceAlive(target) then        return    endif    if oldSlot>=0 then        call BalanceClearFearSlot(oldSlot)    endif    loop        exitwhen i>=32        if not C[8000+i] then            set slot=8000+i            exitwhen true        endif        set i=i+1    endloop    if slot<0 then        return    endif    set o[slot]=target    set w[slot]=caster    set x[slot]=0    set y[slot]=I2R(GetHeroInt(caster,true))*5.0    set C[slot]=true    call BalanceMoveFear(target)endfunctionfunction BalanceFearTick takes nothing returns nothing    local integer i=0    local integer slot=0    local unit target=null    local unit caster=null    loop        exitwhen i>=32        set slot=8000+i        if C[slot] then            set target=o[slot]            set caster=w[slot]            if not BalanceAlive(target) then                call BalanceClearFearSlot(slot)            else                set x[slot]=x[slot]+1                if ModuloInteger(x[slot],10)==0 and BalanceAlive(caster) then                    call UnitDamageTarget(caster,target,y[slot],false,false,ATTACK_TYPE_CHAOS,DAMAGE_TYPE_MAGIC,null)                endif                if x[slot]>=30 then                    call BalanceClearFear(target)                elseif ModuloInteger(x[slot],5)==0 then                    call BalanceMoveFear(target)                endif            endif        endif        set i=i+1    endloop    set target=null    set caster=nullendfunctionfunction BalanceFearOrder takes nothing returns nothing    local unit target=GetTriggerUnit()    local integer slot=BalanceFindFearSlot(target)    if slot>=0 and C[slot] then        call BalanceMoveFear(target)    endif    set target=nullendfunctionfunction BalanceRestoreForm takes integer playerId returns nothing    local integer slot=8179+playerId    local unit body=o[slot]    local unit form=w[slot]    if body!=null then        call ShowUnit(body,true)        if a[slot]!=null then            call SetUnitPositionLoc(body,a[slot])        endif        if BalanceAlive(body) then            call SelectUnitForPlayerSingle(body,GetOwningPlayer(body))        endif    endif    if a[slot]!=null then        call RemoveLocation(a[slot])    endif    set a[slot]=null    set o[slot]=null    set w[slot]=null    set x[slot]=0    set body=null    set form=nullendfunctionfunction BalanceTransformTick takes nothing returns nothing    local integer playerId=0    local integer slot=0    local unit body=null    local unit form=null    loop        exitwhen playerId>=12        set slot=8179+playerId        set form=w[slot]        set body=o[slot]        if form!=null then            if not BalanceAlive(form) then                call BalanceRestoreForm(playerId)            else                if a[slot]!=null then                    call RemoveLocation(a[slot])                endif                set a[slot]=Location(GetUnitX(form),GetUnitY(form))                if body!=null and not BalanceAlive(body) then                    call KillUnit(form)                endif            endif        endif        set playerId=playerId+1    endloop    set body=null    set form=nullendfunctionfunction BalanceRegenerateTemporary takes nothing returns nothing    local group units=CreateGroup()    local unit u=null    local real factor=0.0    call GroupEnumUnitsInRect(units,GetWorldBounds(),null)    loop        set u=FirstOfGroup(units)        exitwhen u==null        call GroupRemoveUnit(units,u)        if BalanceAlive(u) then            if GetUnitTypeId(u)=='H1S1' or GetUnitTypeId(u)=='H1S2' or GetUnitTypeId(u)=='H1S3' or GetUnitTypeId(u)=='H1S4' or GetUnitTypeId(u)=='H1S5' then                set factor=0.005            elseif GetUnitTypeId(u)=='H1B1' or GetUnitTypeId(u)=='H1B2' or GetUnitTypeId(u)=='H1B3' or GetUnitTypeId(u)=='H1B4' or GetUnitTypeId(u)=='H1B5' or GetUnitTypeId(u)=='H1B6' or GetUnitTypeId(u)=='H1B7' then                set factor=0.02            else                set factor=0.0            endif            if factor>0.0 then                call SetWidgetLife(u,RMinBJ(GetUnitState(u,UNIT_STATE_MAX_LIFE),GetWidgetLife(u)+GetUnitState(u,UNIT_STATE_MAX_LIFE)*factor))            endif        endif    endloop    call DestroyGroup(units)    set u=null    set units=nullendfunctionfunction BalancePeriodic takes nothing returns nothing    call BalanceFearTick()    call BalanceTransformTick()    call BalanceRegenerateTemporary()endfunctionfunction BalanceOnDeath takes nothing returns nothing    local unit u=GetTriggerUnit()    local integer playerId=GetPlayerId(GetOwningPlayer(u))    local integer slot=8179+playerId    local integer fearSlot=BalanceFindFearSlot(u)    local integer i=0    if fearSlot>=0 then        call BalanceClearFearSlot(fearSlot)    endif    loop        exitwhen i>=32        if w[8000+i]==u then            call BalanceClearFearSlot(8000+i)        endif        set i=i+1    endloop    if w[slot]==u then        call BalanceRestoreForm(playerId)    elseif o[slot]==u then        if BalanceAlive(w[slot]) then            call KillUnit(w[slot])        endif        call BalanceRestoreForm(playerId)    endif    set u=nullendfunctionfunction BalanceOnSummon takes nothing returns nothing    local unit u=GetSummonedUnit()    local unit hero=GetSummoningUnit()    local integer id=GetUnitTypeId(u)    local integer skill=0    local real duration=30.0    if id=='H1S1' or id=='H1S2' or id=='H1S3' or id=='H1S4' or id=='H1S5' then        if id=='H1S1' then            set skill='A05N'        elseif id=='H1S2' then            set skill='A0AB'        elseif id=='H1S3' then            set skill='A08J'        elseif id=='H1S4' then            set skill='A068'        else            set skill='A0N8'        endif        if GetUnitAbilityLevel(hero,skill)>=2 then            set duration=60.0        endif        if BalanceInitializeAttributes(u,hero,1.4,120,60,4000) then            call UnitApplyTimedLife(u,'BTLF',duration)        else            call RemoveUnit(u)        endif    endif    set hero=null    set u=nullendfunctionfunction BalanceStartTransform takes unit body,integer unitId returns nothing    local unit form=null    local integer playerId=GetPlayerId(GetOwningPlayer(body))    local integer slot=8179+playerId    if w[slot]!=null and BalanceAlive(w[slot]) then        return    endif    if w[slot]!=null then        call BalanceRestoreForm(playerId)    endif    set form=CreateUnit(GetOwningPlayer(body),unitId,GetUnitX(body),GetUnitY(body),GetUnitFacing(body))    if BalanceInitializeAttributes(form,body,3.0,0,120,10000) then        set o[slot]=body        set w[slot]=form        set x[slot]=1        set a[slot]=Location(GetUnitX(form),GetUnitY(form))        call UnitApplyTimedLife(form,'BTLF',60.0)        call ShowUnit(body,false)        call SelectUnitForPlayerSingle(form,GetOwningPlayer(body))    else        call RemoveUnit(form)    endif    set form=nullendfunctionfunction BalanceMirrorImage takes unit caster returns nothing    local integer level=GetUnitAbilityLevel(caster,'A04D')    local integer count=IMinBJ(9,level+1)    local integer index=0    local unit dummy=null    loop        exitwhen index>=count        set dummy=CreateUnit(GetOwningPlayer(caster),'n1BD',GetUnitX(caster),GetUnitY(caster),0.0)        call UnitAddAbility(dummy,'A1MI')        call UnitApplyTimedLife(dummy,'BTLF',2.0)        call IssueTargetOrderById(dummy,852274,caster)        set index=index+1    endloop    set dummy=nullendfunctionfunction BalanceCanHit takes unit source,unit target,boolean air,boolean structures returns boolean    return BalanceAlive(target) and IsUnitEnemy(target,GetOwningPlayer(source)) and GetUnitAbilityLevel(target,'Aloc')==0 and GetUnitAbilityLevel(target,'Avul')==0 and not IsUnitType(target,UNIT_TYPE_MAGIC_IMMUNE) and (air or not IsUnitType(target,UNIT_TYPE_FLYING)) and (structures or not IsUnitType(target,UNIT_TYPE_STRUCTURE))endfunctionfunction BalanceDamageArea takes unit source,real xPos,real yPos,real radius,real damage,boolean air,boolean structures,boolean beast returns nothing    local group targets=CreateGroup()    local unit target=null    call GroupEnumUnitsInRange(targets,xPos,yPos,radius,null)    loop        set target=FirstOfGroup(targets)        exitwhen target==null        call GroupRemoveUnit(targets,target)        if BalanceCanHit(source,target,air,structures) then            call UnitDamageTarget(source,target,damage,false,false,ATTACK_TYPE_MAGIC,DAMAGE_TYPE_MAGIC,null)        endif    endloop    call DestroyGroup(targets)    set target=null    set targets=nullendfunctionfunction BalanceImpale takes unit source,real targetX,real targetY returns nothing    local integer level=GetUnitAbilityLevel(source,'A0CU')    local real damage=100.0*I2R(level)+0.7*BalancePrimaryValue(source)*I2R(level)    call BalanceDamageArea(source,targetX,targetY,400.0,damage,false,false,false)endfunctionfunction BalanceStartWave takes unit source,real targetX,real targetY returns nothing    call BalanceDamageArea(source,targetX,targetY,500.0,I2R(GetHeroStr(source,true))*8.0,true,false,false)endfunctionfunction BalanceStartBomb takes unit source,real targetX,real targetY returns nothing    call AddSpecialEffectLocBJ(Location(targetX,targetY),"Abilities\\Spells\\Other\\Doom\\DoomDeath.mdl")    call DestroyEffect(bj_lastCreatedEffect)    call BalanceDamageArea(source,targetX,targetY,500.0,I2R(GetHeroStr(source,true))*10.0,true,true,true)endfunctionfunction BalanceOnSpell takes nothing returns nothing    local unit source=GetTriggerUnit()    local unit target=GetSpellTargetUnit()    local integer spellId=GetSpellAbilityId()    local real xPos=GetSpellTargetX()    local real yPos=GetSpellTargetY()    if spellId=='A0NB' then        call BalanceStartFear(source,target)    elseif spellId=='A04D' then        call BalanceMirrorImage(source)    elseif spellId=='A0CU' then        call BalanceImpale(source,xPos,yPos)    elseif BalanceIsTemporary(source) then        if spellId=='A1S1' or spellId=='A1S3' or spellId=='A1S5' then            call BalanceStartWave(source,xPos,yPos)        elseif spellId=='A1S2' then            call BalanceDamageArea(source,GetUnitX(source),GetUnitY(source),400.0,I2R(GetHeroStr(source,true))*8.0,false,false,false)        elseif spellId=='A1S4' then            if BalanceCanHit(source,target,true,false) then                call UnitDamageTarget(source,target,I2R(GetHeroStr(source,true))*8.0,false,false,ATTACK_TYPE_MAGIC,DAMAGE_TYPE_MAGIC,null)            endif        elseif spellId=='A1BT' then            call BalanceStartBomb(source,xPos,yPos)        endif    endif    set source=null    set target=nullendfunctionfunction BalanceInit takes nothing returns nothing    local trigger spells=CreateTrigger()    local trigger summoned=CreateTrigger()    local trigger deaths=CreateTrigger()    local trigger orders=CreateTrigger()    local trigger periodic=CreateTrigger()    call TriggerRegisterAnyUnitEventBJ(spells,EVENT_PLAYER_UNIT_SPELL_EFFECT)    call TriggerAddAction(spells,function BalanceOnSpell)    call TriggerRegisterAnyUnitEventBJ(summoned,EVENT_PLAYER_UNIT_SUMMON)    call TriggerAddAction(summoned,function BalanceOnSummon)    call TriggerRegisterAnyUnitEventBJ(deaths,EVENT_PLAYER_UNIT_DEATH)    call TriggerAddAction(deaths,function BalanceOnDeath)    call TriggerRegisterAnyUnitEventBJ(orders,EVENT_PLAYER_UNIT_ISSUED_ORDER)    call TriggerRegisterAnyUnitEventBJ(orders,EVENT_PLAYER_UNIT_ISSUED_POINT_ORDER)    call TriggerRegisterAnyUnitEventBJ(orders,EVENT_PLAYER_UNIT_ISSUED_TARGET_ORDER)    call TriggerAddAction(orders,function BalanceFearOrder)    call TriggerRegisterTimerEventPeriodic(periodic,1.0)    call TriggerAddAction(periodic,function BalancePeriodic)endfunctionfunction SC takes unit TC,unittype UC returns booleanreturn(IsUnitType(TC,UC)!=null)endfunctionfunction VC takes real WC returns nothinglocal real XClocal real st=TimerGetElapsed(KC)if st<=0 thenset KC=CreateTimer()call TimerStart(KC,$F4240,false,null)endifif(WC>0)thenloopset XC=WC-TimerGetElapsed(KC)+stexitwhen XC<=0if(XC>bj_POLLED_WAIT_SKIP_THRESHOLD)thencall TriggerSleepAction(.1*XC)elsecall TriggerSleepAction(bj_POLLED_WAIT_INTERVAL)endifendloopendifendfunctionfunction YC takes location ZC,real dc,real ec returns locationreturn Location(GetLocationX(ZC)+dc*Cos(ec*bj_DEGTORAD),GetLocationY(ZC)+dc*Sin(ec*bj_DEGTORAD))endfunctionfunction fc takes nothing returns booleanlocal real dx=GetDestructableX(GetFilterDestructable())-MClocal real dy=GetDestructableY(GetFilterDestructable())-NCreturn(dx*dx+dy*dy<=bj_enumDestructableRadius)endfunctionfunction gc takes rect r,boolexpr hc returns groupset OC=CreateGroup()call GroupEnumUnitsInRect(OC,r,hc)call DestroyBoolExpr(hc)return OCendfunctionfunction ic takes rect r,player jc returns groupset OC=CreateGroup()set bj_groupEnumOwningPlayer=jccall GroupEnumUnitsInRect(OC,r,filterGetUnitsInRectOfPlayer)return OCendfunctionfunction kc takes real mc,location nc,boolexpr hc returns groupset OC=CreateGroup()call GroupEnumUnitsInRangeOfLoc(OC,nc,mc,hc)return OCendfunctionfunction oc takes real mc,location nc returns groupset OC=CreateGroup()call GroupEnumUnitsInRangeOfLoc(OC,nc,mc,QC)return OCendfunctionfunction pc takes player jc,boolexpr hc returns groupset OC=CreateGroup()call GroupEnumUnitsOfPlayer(OC,jc,hc)call DestroyBoolExpr(hc)return OCendfunctionfunction qc takes player jc returns groupset OC=CreateGroup()call GroupEnumUnitsOfPlayer(OC,jc,QC)return OCendfunctionfunction rc takes mapcontrol sc returns forcelocal integer tclocal player ucset PC=CreateForce()set tc=0loopset uc=Player(tc)if GetPlayerController(uc)==sc thencall ForceAddPlayer(PC,uc)endifset tc=tc+1exitwhen tc==16endloopreturn PCendfunctionfunction vc takes player jc returns forceset PC=CreateForce()call ForceEnumAllies(PC,jc,QC)return PCendfunctionfunction wc takes player jc returns forceset PC=CreateForce()call ForceEnumEnemies(PC,jc,QC)return PCendfunctionfunction xc takes boolexpr hc returns forceset PC=CreateForce()call ForceEnumPlayers(PC,hc)call DestroyBoolExpr(hc)return PCendfunctionfunction yc takes integer zc,group Ac returns groupset bj_randomSubGroupGroup=CreateGroup()set bj_randomSubGroupWant=zcset bj_randomSubGroupTotal=CountUnitsInGroup(Ac)if(bj_randomSubGroupWant<=0 or bj_randomSubGroupTotal<=0)thenreturn bj_randomSubGroupGroupendifset bj_randomSubGroupChance=I2R(bj_randomSubGroupWant)/I2R(bj_randomSubGroupTotal)call ForGroup(Ac,function GetRandomSubGroupEnum)return bj_randomSubGroupGroupendfunctionfunction ac takes itemtype Bc,integer bc returns nothinglocal group gset bj_stockPickedItemType=Bcset bj_stockPickedItemLevel=bcset g=CreateGroup()call GroupEnumUnitsOfType(g,"marketplace",QC)call ForGroup(g,function UpdateEachStockBuildingEnum)call DestroyGroup(g)set g=nullendfunctionfunction Cc takes nothing returns nothinglocal integer pickedItemIdlocal itemtype cclocal integer Dc=0local integer Ec=0local integer bcset bc=1loopif(bj_stockAllowedPermanent[bc])thenset Ec=Ec+1if(GetRandomInt(1,Ec)==1)thenset cc=ITEM_TYPE_PERMANENTset Dc=bcendifendifif(bj_stockAllowedCharged[bc])thenset Ec=Ec+1if(GetRandomInt(1,Ec)==1)thenset cc=ITEM_TYPE_CHARGEDset Dc=bcendifendifif(bj_stockAllowedArtifact[bc])thenset Ec=Ec+1if(GetRandomInt(1,Ec)==1)thenset cc=ITEM_TYPE_ARTIFACTset Dc=bcendifendifset bc=bc+1exitwhen bc>$Aendloopif(Ec==0)thenset cc=nullreturnendifcall ac(cc,Dc)set cc=nullendfunctionfunction Fc takes nothing returns nothingcall Cc()call TimerStart(bj_stockUpdateTimer,bj_STOCK_RESTOCK_INTERVAL,true,function Cc)endfunctionfunction Hc takes nothing returns booleanreturn trueendfunctionfunction Kc takes unit Lc,integer Mc returns itemif(Mc==-1)thenreturn nullendifset RC=CreateItem(Mc,GetUnitX(Lc)+GetRandomReal(-32,32),GetUnitY(Lc)+GetRandomReal(-32,32))call SetItemDropID(RC,GetUnitTypeId(Lc))call UpdateStockAvailability(RC)return RCendfunctionfunction Nc takes nothing returns nothinglocal integer i=0loopexitwhen i>=fif e[i]!=null and IsTriggerEnabled(e[i])and TriggerEvaluate(e[i])thencall TriggerExecute(e[i])endifset i=i+1endloopendfunctionfunction Oc takes nothing returns booleanif GetUnitAbilityLevel(GetFilterUnit(),1097625443)<=0 thencall TriggerRegisterUnitEvent(d,GetFilterUnit(),EVENT_UNIT_DAMAGED)endifreturn falseendfunctionfunction Pc takes nothing returns nothinglocal trigger t=CreateTrigger()local region r=CreateRegion()local group g=CreateGroup()call RegionAddRect(r,GetWorldBounds())call TriggerRegisterEnterRegion(t,r,Condition(function Oc))call GroupEnumUnitsInRect(g,GetWorldBounds(),Condition(function Oc))call DestroyGroup(g)set r=nullset t=nullset g=nullendfunctionfunction Qc takes trigger Rc returns nothingif Rc==null thenreturnendifif f==0 thenset d=CreateTrigger()call TriggerAddAction(d,function Nc)call Pc()endifset e[f]=Rcset f=f+1endfunctionfunction Sc takes nothing returns nothinglocal integer i=0if GetIssuedOrderId()>=$D0022 and GetIssuedOrderId()<=$D0027 thenset h=GetOrderTargetItem()loopexitwhen i>=mif k[i]!=null and IsTriggerEnabled(k[i])and TriggerEvaluate(k[i])thencall TriggerExecute(k[i])endifset i=i+1endloopendifendfunctionfunction GetLastMovedItemInItemSlot takes nothing returns itemreturn hendfunctionfunction Tc takes nothing returns nothinglocal widget Uc=nulllocal unit Vc=nulllocal integer Wc=0local boolean Xc=trueset Uc=bj_lastDyingWidgetif(Uc==null)thenset Vc=GetTriggerUnit()endifif(Vc!=null)thenset Xc=not IsUnitHidden(Vc)if(Xc and GetChangingUnit()!=null)thenset Xc=(GetChangingUnitPrevOwner()==Player($C))endifendifif(Xc)thencall RandomDistReset()call RandomDistAddItem(1920099699,100)set Wc=RandomDistChoose()if(Vc!=null)thencall Kc(Vc,Wc)elsecall WidgetDropItem(Uc,Wc)endifcall RandomDistReset()call RandomDistAddItem(1952807024,100)set Wc=RandomDistChoose()if(Vc!=null)thencall Kc(Vc,Wc)elsecall WidgetDropItem(Uc,Wc)endifcall RandomDistReset()call RandomDistAddItem(1835101800,20)call RandomDistAddItem(1953525623,20)call RandomDistAddItem(1953723506,20)call RandomDistAddItem(1952736632,20)call RandomDistAddItem(1953066612,20)set Wc=RandomDistChoose()if(Vc!=null)thencall Kc(Vc,Wc)elsecall WidgetDropItem(Uc,Wc)endifendifset bj_lastDyingWidget=nullcall DestroyTrigger(GetTriggeringTrigger())endfunctionfunction Yc takes nothing returns nothinglocal widget Uc=nulllocal unit Vc=nulllocal integer Wc=0local boolean Xc=trueset Uc=bj_lastDyingWidgetif(Uc==null)thenset Vc=GetTriggerUnit()endifif(Vc!=null)thenset Xc=not IsUnitHidden(Vc)if(Xc and GetChangingUnit()!=null)thenset Xc=(GetChangingUnitPrevOwner()==Player($C))endifendifif(Xc)thencall RandomDistReset()call RandomDistAddItem(1920099699,34)call RandomDistAddItem(1919444275,33)call RandomDistAddItem(1919770930,33)set Wc=RandomDistChoose()if(Vc!=null)thencall Kc(Vc,Wc)elsecall WidgetDropItem(Uc,Wc)endifcall RandomDistReset()call RandomDistAddItem(1953525623,20)call RandomDistAddItem(1835101800,20)call RandomDistAddItem(1953723506,20)call RandomDistAddItem(1952736632,20)call RandomDistAddItem(1953066612,20)set Wc=RandomDistChoose()if(Vc!=null)thencall Kc(Vc,Wc)elsecall WidgetDropItem(Uc,Wc)endifendifset bj_lastDyingWidget=nullcall DestroyTrigger(GetTriggeringTrigger())endfunctionfunction Zc takes nothing returns nothinglocal widget Uc=nulllocal unit Vc=nulllocal integer Wc=0local boolean Xc=trueset Uc=bj_lastDyingWidgetif(Uc==null)thenset Vc=GetTriggerUnit()endifif(Vc!=null)thenset Xc=not IsUnitHidden(Vc)if(Xc and GetChangingUnit()!=null)thenset Xc=(GetChangingUnitPrevOwner()==Player($C))endifendifif(Xc)thencall RandomDistReset()call RandomDistAddItem(1920099699,34)call RandomDistAddItem(1919444275,33)call RandomDistAddItem(1919770930,33)set Wc=RandomDistChoose()if(Vc!=null)thencall Kc(Vc,Wc)elsecall WidgetDropItem(Uc,Wc)endifcall RandomDistReset()call RandomDistAddItem(1953525623,20)call RandomDistAddItem(1835101800,20)call RandomDistAddItem(1953723506,20)call RandomDistAddItem(1952736632,20)call RandomDistAddItem(1953066612,20)set Wc=RandomDistChoose()if(Vc!=null)thencall Kc(Vc,Wc)elsecall WidgetDropItem(Uc,Wc)endifendifset bj_lastDyingWidget=nullcall DestroyTrigger(GetTriggeringTrigger())endfunctionfunction dD takes nothing returns nothinglocal widget Uc=nulllocal unit Vc=nulllocal integer Wc=0local boolean Xc=trueset Uc=bj_lastDyingWidgetif(Uc==null)thenset Vc=GetTriggerUnit()endifif(Vc!=null)thenset Xc=not IsUnitHidden(Vc)if(Xc and GetChangingUnit()!=null)thenset Xc=(GetChangingUnitPrevOwner()==Player($C))endifendifif(Xc)thencall RandomDistReset()call RandomDistAddItem(1227894852,100)set Wc=RandomDistChoose()if(Vc!=null)thencall Kc(Vc,Wc)elsecall WidgetDropItem(Uc,Wc)endifendifset bj_lastDyingWidget=nullcall DestroyTrigger(GetTriggeringTrigger())endfunctionfunction eD takes nothing returns nothinglocal widget Uc=nulllocal unit Vc=nulllocal integer Wc=0local boolean Xc=trueset Uc=bj_lastDyingWidgetif(Uc==null)thenset Vc=GetTriggerUnit()endif