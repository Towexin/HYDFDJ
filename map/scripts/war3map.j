ullunit ob=nullunit pb=nullunit qb=nullunit rb=nullunit sb=nullunit tb=nullunit ub=nullunit vb=nullunit wb=nullunit xb=nullunit yb=nullunit zb=nullunit Ab=nullunit ab=nullunit Bb=nullunit bb=nullunit Cb=nullunit cb=nullunit Db=nullunit Eb=nullunit Fb=nullunit Gb=nullunit Hb=nullunit Ib=nullunit lb=nullunit Jb=nullunit Kb=nullunit Lb=nullunit Mb=nullunit Nb=nullunit Ob=nullunit Pb=nullunit Qb=nullunit Rb=nullunit Sb=nullunit Tb=nullunit Ub=nullunit Vb=nullunit Wb=nullunit Xb=nullunit Yb=nullunit Zb=nullunit dC=nullunit eC=nullunit fC=nullunit gC=nullunit hC=nullunit iC=nullunit jC=nullunit kC=nullunit mC=nullunit nC=nullunit oC=nullunit pC=nullunit qC=nullunit rC=nullunit sC=nullunit tC=nullunit uC=nullunit vC=nullunit wC=nullunit xC=nullunit yC=nullunit zC=nullunit AC=nullunit aC=nullunit BC=nullunit bC=nullunit CC=nullunit cC=nullunit DC=nullunit EC=nullunit FC=nullunit GC=nullunit HC=nullunit IC=nullunit lC=nullunit JC=nulltimer KC=nullreal MC=.0real NC=.0group OC=nullforce PC=nullboolexpr QC=nullitem RC=nullendglobalsfunction SC takes unit TC,unittype UC returns booleanreturn(IsUnitType(TC,UC)!=null)endfunctionfunction VC takes real WC returns nothinglocal real XClocal real st=TimerGetElapsed(KC)if st<=0 thenset KC=CreateTimer()call TimerStart(KC,$F4240,false,null)endifif(WC>0)thenloopset XC=WC-TimerGetElapsed(KC)+stexitwhen XC<=0if(XC>bj_POLLED_WAIT_SKIP_THRESHOLD)thencall TriggerSleepAction(.1*XC)elsecall TriggerSleepAction(bj_POLLED_WAIT_INTERVAL)endifendloopendifendfunctionfunction YC takes location ZC,real dc,real ec returns locationreturn Location(GetLocationX(ZC)+dc*Cos(ec*bj_DEGTORAD),GetLocationY(ZC)+dc*Sin(ec*bj_DEGTORAD))endfunctionfunction fc takes nothing returns booleanlocal real dx=GetDestructableX(GetFilterDestructable())-MClocal real dy=GetDestructableY(GetFilterDestructable())-NCreturn(dx*dx+dy*dy<=bj_enumDestructableRadius)endfunctionfunction gc takes rect r,boolexpr hc returns groupset OC=CreateGroup()call GroupEnumUnitsInRect(OC,r,hc)call DestroyBoolExpr(hc)return OCendfunctionfunction ic takes rect r,player jc returns groupset OC=CreateGroup()set bj_groupEnumOwningPlayer=jccall GroupEnumUnitsInRect(OC,r,filterGetUnitsInRectOfPlayer)return OCendfunctionfunction kc takes real mc,location nc,boolexpr hc returns groupset OC=CreateGroup()call GroupEnumUnitsInRangeOfLoc(OC,nc,mc,hc)return OCendfunctionfunction oc takes real mc,location nc returns groupset OC=CreateGroup()call GroupEnumUnitsInRangeOfLoc(OC,nc,mc,QC)return OCendfunctionfunction pc takes player jc,boolexpr hc returns groupset OC=CreateGroup()call GroupEnumUnitsOfPlayer(OC,jc,hc)call DestroyBoolExpr(hc)return OCendfunctionfunction qc takes player jc returns groupset OC=CreateGroup()call GroupEnumUnitsOfPlayer(OC,jc,QC)return OCendfunctionfunction rc takes mapcontrol sc returns forcelocal integer tclocal player ucset PC=CreateForce()set tc=0loopset uc=Player(tc)if GetPlayerController(uc)==sc thencall ForceAddPlayer(PC,uc)endifset tc=tc+1exitwhen tc==16endloopreturn PCendfunctionfunction vc takes player jc returns forceset PC=CreateForce()call ForceEnumAllies(PC,jc,QC)return PCendfunctionfunction wc takes player jc returns forceset PC=CreateForce()call ForceEnumEnemies(PC,jc,QC)return PCendfunctionfunction xc takes boolexpr hc returns forceset PC=CreateForce()call ForceEnumPlayers(PC,hc)call DestroyBoolExpr(hc)return PCendfunctionfunction yc takes integer zc,group Ac returns groupset bj_randomSubGroupGroup=CreateGroup()set bj_randomSubGroupWant=zcset bj_randomSubGroupTotal=CountUnitsInGroup(Ac)if(bj_randomSubGroupWant<=0 or bj_randomSubGroupTotal<=0)thenreturn bj_randomSubGroupGroupendifset bj_randomSubGroupChance=I2R(bj_randomSubGroupWant)/I2R(bj_randomSubGroupTotal)call ForGroup(Ac,function GetRandomSubGroupEnum)return bj_randomSubGroupGroupendfunctionfunction ac takes itemtype Bc,integer bc returns nothinglocal group gset bj_stockPickedItemType=Bcset bj_stockPickedItemLevel=bcset g=CreateGroup()call GroupEnumUnitsOfType(g,"marketplace",QC)call ForGroup(g,function UpdateEachStockBuildingEnum)call DestroyGroup(g)set g=nullendfunctionfunction Cc takes nothing returns nothinglocal integer pickedItemIdlocal itemtype cclocal integer Dc=0local integer Ec=0local integer bcset bc=1loopif(bj_stockAllowedPermanent[bc])thenset Ec=Ec+1if(GetRandomInt(1,Ec)==1)thenset cc=ITEM_TYPE_PERMANENTset Dc=bcendifendifif(bj_stockAllowedCharged[bc])thenset Ec=Ec+1if(GetRandomInt(1,Ec)==1)thenset cc=ITEM_TYPE_CHARGEDset Dc=bcendifendifif(bj_stockAllowedArtifact[bc])thenset Ec=Ec+1if(GetRandomInt(1,Ec)==1)thenset cc=ITEM_TYPE_ARTIFACTset Dc=bcendifendifset bc=bc+1exitwhen bc>$Aendloopif(Ec==0)thenset cc=nullreturnendifcall ac(cc,Dc)set cc=nullendfunctionfunction Fc takes nothing returns nothingcall Cc()call TimerStart(bj_stockUpdateTimer,bj_STOCK_RESTOCK_INTERVAL,true,function Cc)endfunctionfunction Hc takes nothing returns booleanreturn trueendfunctionfunction Kc takes unit Lc,integer Mc returns itemif(Mc==-1)thenreturn nullendifset RC=CreateItem(Mc,GetUnitX(Lc)+GetRandomReal(-32,32),GetUnitY(Lc)+GetRandomReal(-32,32))call SetItemDropID(RC,GetUnitTypeId(Lc))call UpdateStockAvailability(RC)return RCendfunctionfunction Nc takes nothing returns nothinglocal integer i=0loopexitwhen i>=fif e[i]!=null and IsTriggerEnabled(e[i])and TriggerEvaluate(e[i])thencall TriggerExecute(e[i])endifset i=i+1endloopendfunctionfunction Oc takes nothing returns booleanif GetUnitAbilityLevel(GetFilterUnit(),1097625443)<=0 thencall TriggerRegisterUnitEvent(d,GetFilterUnit(),EVENT_UNIT_DAMAGED)endifreturn falseendfunctionfunction Pc takes nothing returns nothinglocal trigger t=CreateTrigger()local region r=CreateRegion()local group g=CreateGroup()call RegionAddRect(r,GetWorldBounds())call TriggerRegisterEnterRegion(t,r,Condition(function Oc))call GroupEnumUnitsInRect(g,GetWorldBounds(),Condition(function Oc))call DestroyGroup(g)set r=nullset t=nullset g=nullendfunctionfunction Qc takes trigger Rc returns nothingif Rc==null thenreturnendifif f==0 thenset d=CreateTrigger()call TriggerAddAction(d,function Nc)call Pc()endifset e[f]=Rcset f=f+1endfunctionfunction Sc takes nothing returns nothinglocal integer i=0if GetIssuedOrderId()>=$D0022 and GetIssuedOrderId()<=$D0027 thenset h=GetOrderTargetItem()loopexitwhen i>=mif k[i]!=null and IsTriggerEnabled(k[i])and TriggerEvaluate(k[i])thencall TriggerExecute(k[i])endifset i=i+1endloopendifendfunctionfunction GetLastMovedItemInItemSlot takes nothing returns itemreturn hendfunctionfunction Tc takes nothing returns nothinglocal widget Uc=nulllocal unit Vc=nulllocal integer Wc=0local boolean Xc=trueset Uc=bj_lastDyingWidgetif(Uc==null)thenset Vc=GetTriggerUnit()endifif(Vc!=null)thenset Xc=not IsUnitHidden(Vc)if(Xc and GetChangingUnit()!=null)thenset Xc=(GetChangingUnitPrevOwner()==Player($C))endifendifif(Xc)thencall RandomDistReset()call RandomDistAddItem(1920099699,100)set Wc=RandomDistChoose()if(Vc!=null)thencall Kc(Vc,Wc)elsecall WidgetDropItem(Uc,Wc)endifcall RandomDistReset()call RandomDistAddItem(1952807024,100)set Wc=RandomDistChoose()if(Vc!=null)thencall Kc(Vc,Wc)elsecall WidgetDropItem(Uc,Wc)endifcall RandomDistReset()call RandomDistAddItem(1835101800,20)call RandomDistAddItem(1953525623,20)call RandomDistAddItem(1953723506,20)call RandomDistAddItem(1952736632,20)call RandomDistAddItem(1953066612,20)set Wc=RandomDistChoose()if(Vc!=null)thencall Kc(Vc,Wc)elsecall WidgetDropItem(Uc,Wc)endifendifset bj_lastDyingWidget=nullcall DestroyTrigger(GetTriggeringTrigger())endfunctionfunction Yc takes nothing returns nothinglocal widget Uc=nulllocal unit Vc=nulllocal integer Wc=0local boolean Xc=trueset Uc=bj_lastDyingWidge